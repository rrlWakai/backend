# GitHub personal access token (classic, read:user scope is enough).
# Create at https://github.com/settings/tokens — never commit the real value.
GITHUB_TOKEN=ghp_your_token_here

# GitHub username whose contribution graph is served
GITHUB_USERNAME=rrlWakai

# Your deployed frontend origin (no trailing slash needed — it's normalized).
# Localhost dev origins (http://localhost:5173 / :3000) are always allowed automatically.
FRONTEND_URL=https://your-frontend.vercel.app
